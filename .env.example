# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Admin Configuration (comma-separated user IDs)
ADMIN_IDS=123456789

# User Access Control (comma-separated user IDs, empty = allow all)
ALLOWED_USER_IDS=
BLOCKED_USER_IDS=

# Usage Limits
DAILY_MESSAGE_LIMIT=50
MAX_INPUT_CHARACTERS=12000
MAX_CONVERSATION_MESSAGES=20

# Server Configuration
PORT=8080
LOG_LEVEL=info

# Timeouts (in seconds)
REQUEST_TIMEOUT=30
POLLING_TIMEOUT=30

# Storage (memory by default, can be extended)
STORAGE_TYPE=memory
